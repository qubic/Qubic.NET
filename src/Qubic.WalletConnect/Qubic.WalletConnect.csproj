<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Package Metadata -->
    <PackageId>Qubic.WalletConnect</PackageId>
    <Version>1.0.0</Version>
    <Authors>Qubic.NET Contributors</Authors>
    <Description>WalletConnect v2 wallet side for Qubic (namespace "qubic"): pairing, session approval and the official Qubic method set, on top of Reown WalletKit and Qubic.Services signing review.</Description>
    <PackageTags>qubic;blockchain;walletconnect</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Reown.WalletKit" Version="1.7.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qubic.Services\Qubic.Services.csproj" />
  </ItemGroup>

</Project>
