<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Package Metadata -->
    <PackageId>Qubic.Core</PackageId>
    <Version>1.301.9</Version>
    <Authors>Qubic.NET Contributors</Authors>
    <Description>Core domain models and abstractions for the Qubic network</Description>
    <PackageTags>qubic;blockchain;cryptocurrency</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in contract metadata for runtime decoding. Regenerate with tools/Qubic.ContractGen in metadata-only mode. -->
    <EmbeddedResource Include="Contracts\Metadata\builtin-contracts.json" LogicalName="Qubic.Core.Contracts.Metadata.builtin-contracts.json" WithCulture="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Qubic.Core.Tests" />
    <InternalsVisibleTo Include="Qubic.Serialization.Tests" />
    <InternalsVisibleTo Include="Qubic.Network.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Qubic.Crypto" Version="1.5.2" />
  </ItemGroup>

</Project>
