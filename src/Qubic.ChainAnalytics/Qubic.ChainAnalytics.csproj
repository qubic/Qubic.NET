<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- NuGet Package Metadata -->
    <PackageId>Qubic.ChainAnalytics</PackageId>
    <Version>0.1.0</Version>
    <Authors>Qubic.NET Contributors</Authors>
    <Description>Direct-mainnet chain analytics for Qubic: tick summaries, transaction parsing, digest/hash/chain verification — built on raw TCP via Qubic.Network. No RPC, no Bob.</Description>
    <PackageTags>qubic;blockchain;analytics</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Qubic.Core\Qubic.Core.csproj" />
    <ProjectReference Include="..\Qubic.Network\Qubic.Network.csproj" />
    <ProjectReference Include="..\Qubic.Serialization\Qubic.Serialization.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Qubic.Crypto" Version="1.5.2" />
  </ItemGroup>

</Project>
